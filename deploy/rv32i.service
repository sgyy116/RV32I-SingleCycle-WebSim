[Unit]
Description=RV32I Web Simulator
After=network.target

[Service]
Type=simple
User=rv32i
Group=rv32i
WorkingDirectory=/opt/rv32i/backend/python
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=RV32I_BIND_HOST=127.0.0.1
Environment=RV32I_SERVER_MODE=1
Environment=WS_PORT=8080
Environment=COMPILE_PORT=8081
ExecStart=/opt/rv32i/.venv/bin/python -B server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
